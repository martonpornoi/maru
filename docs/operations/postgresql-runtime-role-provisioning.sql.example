-- Maru PostgreSQL 17 runtime-role provisioning example.
--
-- Run this once through an audited database role administrator/owner that may
-- create roles, change database/schema ACLs, and alter default privileges for
-- the named migration role.  This is not the runtime role and need not be the
-- ordinary migration login.  Keep administrator, migration, runtime, and
-- break-glass roles distinct.  Replace the three example identifiers below.
-- Do not put a password in this file: provision the login credential through
-- the deployment secret manager or managed database identity after review.
--
-- Example identifiers used below:
--   database:       maru
--   migration role: maru_migration
--   runtime role:   maru_runtime
--
-- The file is transaction-wrapped.  Run it with a client that reports errors
-- and does not split statements across connections.  A missing object,
-- signature, role, or privilege aborts the transaction; do not continue by
-- manually committing a partially edited copy.

BEGIN;

DO $maru_runtime_role_preflight$
BEGIN
    IF pg_catalog.current_database() <> 'maru' THEN
        RAISE EXCEPTION 'connect to the reviewed target database first';
    END IF;

    IF NOT EXISTS (
        SELECT 1
          FROM pg_catalog.pg_roles
         WHERE rolname = 'maru_migration'
    ) THEN
        RAISE EXCEPTION 'the reviewed migration role must exist first';
    END IF;

    IF EXISTS (
        SELECT 1
          FROM pg_catalog.pg_roles
         WHERE rolname = 'maru_runtime'
    ) THEN
        RAISE EXCEPTION 'the runtime role already exists; use a reviewed reconciliation';
    END IF;
END
$maru_runtime_role_preflight$;

CREATE ROLE maru_runtime
    LOGIN
    PASSWORD NULL
    NOSUPERUSER
    NOCREATEDB
    NOCREATEROLE
    NOREPLICATION
    NOBYPASSRLS;

-- PUBLIC receives CONNECT/TEMPORARY on a database and CREATE/USAGE on public
-- by default.  Preserve an explicit migration DDL plane before closing those
-- defaults, then make the runtime data plane explicit.  The migration role
-- must already own, or deliberately inherit ownership authority for, existing
-- Maru objects: ACL grants cannot confer ALTER/DROP ownership, and this file
-- will not guess or reassign a historical owner.
REVOKE CONNECT, CREATE, TEMPORARY ON DATABASE maru FROM PUBLIC;
GRANT CONNECT, CREATE, TEMPORARY ON DATABASE maru TO maru_migration;
REVOKE CREATE, TEMPORARY ON DATABASE maru FROM maru_runtime;
GRANT CONNECT ON DATABASE maru TO maru_runtime;

REVOKE CREATE, USAGE ON SCHEMA public FROM PUBLIC;
GRANT CREATE, USAGE ON SCHEMA public TO maru_migration;
REVOKE CREATE ON SCHEMA public FROM maru_runtime;

GRANT USAGE ON SCHEMA public TO maru_runtime;
GRANT SELECT, INSERT, UPDATE, DELETE
    ON ALL TABLES IN SCHEMA public
    TO maru_runtime;
GRANT USAGE, SELECT
    ON ALL SEQUENCES IN SCHEMA public
    TO maru_runtime;

-- Make future ordinary tables and sequences usable without granting ownership
-- or DDL. PostgreSQL default ACLs cannot express per-table exceptions. Apply
-- schema migrations first, then run or reconcile this artifact while writers
-- remain stopped so every restricted relation listed below is narrowed before
-- the runtime login resumes.
ALTER DEFAULT PRIVILEGES FOR ROLE maru_migration IN SCHEMA public
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO maru_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE maru_migration IN SCHEMA public
    GRANT USAGE, SELECT ON SEQUENCES TO maru_runtime;

-- Migration metadata and cutover state are controlled by the audited
-- migration/cutover owner.  The application login may inspect them for
-- readiness and policy decisions, but it must never rewrite migration history
-- or activate, acknowledge, or reset exact provenance itself.  Keep these
-- revokes after blanket/default table grants, and reapply them if any protected
-- relation is ever recreated.
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.django_migrations,
    public.authorization_authorityprovenanceactivation,
    public.authorization_provenanceactivationlatch
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.django_migrations,
    public.authorization_authorityprovenanceactivation,
    public.authorization_provenanceactivationlatch
    FROM PUBLIC;
GRANT SELECT ON TABLE
    public.django_migrations,
    public.authorization_authorityprovenanceactivation,
    public.authorization_provenanceactivationlatch
    TO maru_runtime;

-- Organization structure receipts are append-only runtime evidence. Structure
-- controls are optimistic-concurrency aggregates that may be inserted and
-- advanced, but never deleted, by runtime. REFERENCES is unnecessary for both
-- relations and remains denied at table and column level by the catalog proof.
-- Keep these explicit exceptions after blanket/default grants. Department is
-- intentionally absent: it retains ordinary runtime DML and its stopped-writer
-- retirement trigger remains the database integrity boundary.
REVOKE UPDATE, DELETE, REFERENCES ON TABLE
    public.workforce_editionstructurecommandreceipt
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.workforce_editionstructurecommandreceipt
    FROM PUBLIC;
GRANT SELECT, INSERT ON TABLE
    public.workforce_editionstructurecommandreceipt
    TO maru_runtime;

REVOKE DELETE, REFERENCES ON TABLE
    public.workforce_editionstructurecontrol
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.workforce_editionstructurecontrol
    FROM PUBLIC;
GRANT SELECT, INSERT, UPDATE ON TABLE
    public.workforce_editionstructurecontrol
    TO maru_runtime;

-- Position-assignment and person-owned Availability receipts are append-only
-- runtime evidence. Their parent aggregates may be created and advanced by
-- guarded commands, but never deleted. Current Availability periods are a
-- complete replacement set: runtime may insert the new set and delete the old
-- set, but cannot update an individual period in place. Database triggers
-- require the exact final aggregate, period, and receipt evidence at commit.
REVOKE UPDATE, DELETE, REFERENCES ON TABLE
    public.workforce_positionassignmentcommandreceipt,
    public.workforce_personavailabilitycommandreceipt
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.workforce_positionassignmentcommandreceipt,
    public.workforce_personavailabilitycommandreceipt
    FROM PUBLIC;
GRANT SELECT, INSERT ON TABLE
    public.workforce_positionassignmentcommandreceipt,
    public.workforce_personavailabilitycommandreceipt
    TO maru_runtime;

REVOKE DELETE, REFERENCES ON TABLE
    public.workforce_positionassignment,
    public.workforce_personavailabilityplan
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.workforce_positionassignment,
    public.workforce_personavailabilityplan
    FROM PUBLIC;
GRANT SELECT, INSERT, UPDATE ON TABLE
    public.workforce_positionassignment,
    public.workforce_personavailabilityplan
    TO maru_runtime;

REVOKE UPDATE, REFERENCES ON TABLE
    public.workforce_personavailabilitywindow
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.workforce_personavailabilitywindow
    FROM PUBLIC;
GRANT SELECT, INSERT, DELETE ON TABLE
    public.workforce_personavailabilitywindow
    TO maru_runtime;

-- Registration setup and account onboarding profile-value revisions and command receipts are append-only runtime
-- evidence. Their per-registration/stable-key control may be created and
-- advanced but never deleted or referenced by the application login. Keep
-- these exceptions after blanket/default grants; migration 0036's triggers
-- enforce typed values, exact sequences, provenance, digest, and final
-- evidence completeness.
REVOKE UPDATE, DELETE, REFERENCES ON TABLE
    public.registration_registrationprofileextensionvaluerevision,
    public.registration_registrationprofileextensionvaluecommandreceipt
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.registration_registrationprofileextensionvaluerevision,
    public.registration_registrationprofileextensionvaluecommandreceipt
    FROM PUBLIC;
GRANT SELECT, INSERT ON TABLE
    public.registration_registrationprofileextensionvaluerevision,
    public.registration_registrationprofileextensionvaluecommandreceipt
    TO maru_runtime;

REVOKE DELETE, REFERENCES ON TABLE
    public.registration_registrationprofileextensionvaluecontrol
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.registration_registrationprofileextensionvaluecontrol
    FROM PUBLIC;
GRANT SELECT, INSERT, UPDATE ON TABLE
    public.registration_registrationprofileextensionvaluecontrol
    TO maru_runtime;

-- Registration setup and account onboarding migrations identity 0011 through 0018 are additive: these ACLs narrow
-- their current runtime data plane but do not activate the future
-- stopped-writer generation. Transitions, command receipts, reconciliation
-- receipts, retention receipts, and successful scheduler heartbeats are
-- append-only. Every scheduler INSERT is independently database-timed and
-- cursor-coherent under the v9 readiness contract.
REVOKE UPDATE, DELETE, REFERENCES ON TABLE
    public.identity_platformaccountinvitationtransition,
    public.identity_platformaccountinvitationcommandreceipt,
    public.identity_platformidentitydeliveryreconciliationreceipt,
    public.identity_platforminvitationretentionreceipt,
    public.identity_platforminvitationschedulerrun
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.identity_platformaccountinvitationtransition,
    public.identity_platformaccountinvitationcommandreceipt,
    public.identity_platformidentitydeliveryreconciliationreceipt,
    public.identity_platforminvitationretentionreceipt,
    public.identity_platforminvitationschedulerrun
    FROM PUBLIC;
GRANT SELECT, INSERT ON TABLE
    public.identity_platformaccountinvitationtransition,
    public.identity_platformaccountinvitationcommandreceipt,
    public.identity_platformidentitydeliveryreconciliationreceipt,
    public.identity_platforminvitationretentionreceipt,
    public.identity_platforminvitationschedulerrun
    TO maru_runtime;

-- The singleton account-inventory control is seeded by migration. Runtime may
-- advance it but cannot create, delete, reference, or recreate the singleton.
REVOKE INSERT, DELETE, REFERENCES ON TABLE
    public.identity_platformaccountinventorycontrol
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.identity_platformaccountinventorycontrol
    FROM PUBLIC;
GRANT SELECT, UPDATE ON TABLE
    public.identity_platformaccountinventorycontrol
    TO maru_runtime;

-- The reviewed retention-policy control is activated only by the separately
-- credentialed migration owner. Runtime cleanup may read but never change it.
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.identity_platforminvitationretentionpolicycontrol
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.identity_platforminvitationretentionpolicycontrol
    FROM PUBLIC;
GRANT SELECT ON TABLE
    public.identity_platforminvitationretentionpolicycontrol
    TO maru_runtime;

-- A hold has one audited active-to-released update. It is never deleted or
-- truncated; the trigger requires exact platform-actor and audit evidence.
REVOKE DELETE, REFERENCES ON TABLE
    public.identity_platforminvitationretentionhold
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.identity_platforminvitationretentionhold
    FROM PUBLIC;
GRANT SELECT, INSERT, UPDATE ON TABLE
    public.identity_platforminvitationretentionhold
    TO maru_runtime;

-- Invitation challenges and invitation/delivery aggregates are created and
-- advanced through their commands. Retention v9 updates parent/attempt/late
-- provider references exactly once and advances one minimized assessment per
-- invitation only until `disposed`; parent delivery and disposed assessment
-- evidence are terminal after that transition. Database triggers reject every
-- other update. Cleanup is runtime-writable
-- only after the owner-activated policy control matches the deployment setting
-- exactly.
REVOKE DELETE, REFERENCES ON TABLE
    public.identity_identitychallenge,
    public.identity_platformaccountinvitation,
    public.identity_platformidentitydelivery,
    public.identity_platformidentitydeliveryattempt,
    public.identity_platformidentitydeliverylateoutcome,
    public.identity_platforminvitationretentionassessment
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.identity_identitychallenge,
    public.identity_platformaccountinvitation,
    public.identity_platformidentitydelivery,
    public.identity_platformidentitydeliveryattempt,
    public.identity_platformidentitydeliverylateoutcome,
    public.identity_platforminvitationretentionassessment
    FROM PUBLIC;
GRANT SELECT, INSERT, UPDATE ON TABLE
    public.identity_identitychallenge,
    public.identity_platformaccountinvitation,
    public.identity_platformidentitydelivery,
    public.identity_platformidentitydeliveryattempt,
    public.identity_platformidentitydeliverylateoutcome,
    public.identity_platforminvitationretentionassessment
    TO maru_runtime;

-- Bounded Applications, Charity, Catalog, and Venue evidence relations are
-- create-only at runtime. Their database guards reject updates/deletes and
-- their command services never require REFERENCES. Retained aggregates may
-- be created and advanced through their guarded lifecycle but never deleted;
-- Venue occupancy advances monotonically from active to inactive.
REVOKE UPDATE, DELETE, REFERENCES ON TABLE
    public.applications_applicationfilereceipt,
    public.applications_applicationanswerrevision,
    public.applications_applicationreviewdecision,
    public.applications_applicationtargetrecord,
    public.applications_applicationcommandreceipt,
    public.charities_charityselectiontimelineentry,
    public.charities_charitypublicationsnapshot,
    public.charities_charitycommandreceipt,
    public.catalog_catalogstockadjustment,
    public.catalog_catalogcommandreceipt,
    public.catalog_catalogpaymentevent,
    public.catalog_catalogordertimelineentry,
    public.catalog_catalogorderline,
    public.venues_venuespacecombinationmember,
    public.venues_editionspacemember,
    public.venues_editionspaceavailabilitywindow,
    public.venues_venuebookinghistory,
    public.venues_venuecommandreceipt
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.applications_applicationfilereceipt,
    public.applications_applicationanswerrevision,
    public.applications_applicationreviewdecision,
    public.applications_applicationtargetrecord,
    public.applications_applicationcommandreceipt,
    public.charities_charityselectiontimelineentry,
    public.charities_charitypublicationsnapshot,
    public.charities_charitycommandreceipt,
    public.catalog_catalogstockadjustment,
    public.catalog_catalogcommandreceipt,
    public.catalog_catalogpaymentevent,
    public.catalog_catalogordertimelineentry,
    public.catalog_catalogorderline,
    public.venues_venuespacecombinationmember,
    public.venues_editionspacemember,
    public.venues_editionspaceavailabilitywindow,
    public.venues_venuebookinghistory,
    public.venues_venuecommandreceipt
    FROM PUBLIC;
GRANT SELECT, INSERT ON TABLE
    public.applications_applicationfilereceipt,
    public.applications_applicationanswerrevision,
    public.applications_applicationreviewdecision,
    public.applications_applicationtargetrecord,
    public.applications_applicationcommandreceipt,
    public.charities_charityselectiontimelineentry,
    public.charities_charitypublicationsnapshot,
    public.charities_charitycommandreceipt,
    public.catalog_catalogstockadjustment,
    public.catalog_catalogcommandreceipt,
    public.catalog_catalogpaymentevent,
    public.catalog_catalogordertimelineentry,
    public.catalog_catalogorderline,
    public.venues_venuespacecombinationmember,
    public.venues_editionspacemember,
    public.venues_editionspaceavailabilitywindow,
    public.venues_venuebookinghistory,
    public.venues_venuecommandreceipt
    TO maru_runtime;

REVOKE DELETE, REFERENCES ON TABLE
    public.applications_applicationdefinition,
    public.applications_applicationsubmission,
    public.charities_charitypartner,
    public.charities_charitypartnermedia,
    public.charities_charityselection,
    public.catalog_editioncatalog,
    public.catalog_catalogproduct,
    public.catalog_catalogvariant,
    public.catalog_catalogorder,
    public.catalog_catalogpaymentintent,
    public.venues_venueproperty,
    public.venues_venuepropertymedia,
    public.venues_venuesite,
    public.venues_venuebuilding,
    public.venues_venuespace,
    public.venues_venuespaceconfiguration,
    public.venues_venuespacecombination,
    public.venues_venuelayoutversion,
    public.venues_accommodationroomtype,
    public.venues_accommodationnightinventory,
    public.venues_editionvenueselection,
    public.venues_editionspaceselection,
    public.venues_venuebooking,
    public.venues_venuebookingoccupancy
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.applications_applicationdefinition,
    public.applications_applicationsubmission,
    public.charities_charitypartner,
    public.charities_charitypartnermedia,
    public.charities_charityselection,
    public.catalog_editioncatalog,
    public.catalog_catalogproduct,
    public.catalog_catalogvariant,
    public.catalog_catalogorder,
    public.catalog_catalogpaymentintent,
    public.venues_venueproperty,
    public.venues_venuepropertymedia,
    public.venues_venuesite,
    public.venues_venuebuilding,
    public.venues_venuespace,
    public.venues_venuespaceconfiguration,
    public.venues_venuespacecombination,
    public.venues_venuelayoutversion,
    public.venues_accommodationroomtype,
    public.venues_accommodationnightinventory,
    public.venues_editionvenueselection,
    public.venues_editionspaceselection,
    public.venues_venuebooking,
    public.venues_venuebookingoccupancy
    FROM PUBLIC;
GRANT SELECT, INSERT, UPDATE ON TABLE
    public.applications_applicationdefinition,
    public.applications_applicationsubmission,
    public.charities_charitypartner,
    public.charities_charitypartnermedia,
    public.charities_charityselection,
    public.catalog_editioncatalog,
    public.catalog_catalogproduct,
    public.catalog_catalogvariant,
    public.catalog_catalogorder,
    public.catalog_catalogpaymentintent,
    public.venues_venueproperty,
    public.venues_venuepropertymedia,
    public.venues_venuesite,
    public.venues_venuebuilding,
    public.venues_venuespace,
    public.venues_venuespaceconfiguration,
    public.venues_venuespacecombination,
    public.venues_venuelayoutversion,
    public.venues_accommodationroomtype,
    public.venues_accommodationnightinventory,
    public.venues_editionvenueselection,
    public.venues_editionspaceselection,
    public.venues_venuebooking,
    public.venues_venuebookingoccupancy
    TO maru_runtime;

-- ADR-0054 Logistics facts are narrowed after the blanket grants. Append-only
-- evidence and create-only catalog facts may be selected and inserted only;
-- the seven command aggregates below may also execute their guarded UPDATEs.
-- No Logistics relation grants DELETE, REFERENCES, TRUNCATE, TRIGGER, or
-- MAINTAIN to the runtime login.
REVOKE UPDATE, DELETE, REFERENCES ON TABLE
    public.logistics_equipmentofferitem,
    public.logistics_equipmentofferhistory,
    public.logistics_equipmentofferacceptance,
    public.logistics_keyholderresponsibility,
    public.logistics_assetagreement,
    public.logistics_reusablekitline,
    public.logistics_logisticsmanifestline,
    public.logistics_logisticsevent,
    public.logistics_offlinescanoperation,
    public.logistics_offlineoperationreceipt,
    public.logistics_logisticscommandreceipt,
    public.logistics_logisticsparty,
    public.logistics_logisticsnode,
    public.logistics_asset,
    public.logistics_stocklot,
    public.logistics_reusablekit,
    public.logistics_logisticslabel,
    public.logistics_logisticsdiscrepancy
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.logistics_equipmentofferitem,
    public.logistics_equipmentofferhistory,
    public.logistics_equipmentofferacceptance,
    public.logistics_keyholderresponsibility,
    public.logistics_assetagreement,
    public.logistics_reusablekitline,
    public.logistics_logisticsmanifestline,
    public.logistics_logisticsevent,
    public.logistics_offlinescanoperation,
    public.logistics_offlineoperationreceipt,
    public.logistics_logisticscommandreceipt,
    public.logistics_logisticsparty,
    public.logistics_logisticsnode,
    public.logistics_asset,
    public.logistics_stocklot,
    public.logistics_reusablekit,
    public.logistics_logisticslabel,
    public.logistics_logisticsdiscrepancy
    FROM PUBLIC;
GRANT SELECT, INSERT ON TABLE
    public.logistics_equipmentofferitem,
    public.logistics_equipmentofferhistory,
    public.logistics_equipmentofferacceptance,
    public.logistics_keyholderresponsibility,
    public.logistics_assetagreement,
    public.logistics_reusablekitline,
    public.logistics_logisticsmanifestline,
    public.logistics_logisticsevent,
    public.logistics_offlinescanoperation,
    public.logistics_offlineoperationreceipt,
    public.logistics_logisticscommandreceipt,
    public.logistics_logisticsparty,
    public.logistics_logisticsnode,
    public.logistics_asset,
    public.logistics_stocklot,
    public.logistics_reusablekit,
    public.logistics_logisticslabel,
    public.logistics_logisticsdiscrepancy
    TO maru_runtime;

REVOKE DELETE, REFERENCES ON TABLE
    public.logistics_restrictedlogisticsaddress,
    public.logistics_equipmentoffer,
    public.logistics_physicalkey,
    public.logistics_logisticsmanifest,
    public.logistics_logisticscurrentstate,
    public.logistics_logisticseditioncontrol,
    public.logistics_offlinescanbatch
    FROM maru_runtime;
REVOKE INSERT, UPDATE, DELETE, REFERENCES ON TABLE
    public.logistics_restrictedlogisticsaddress,
    public.logistics_equipmentoffer,
    public.logistics_physicalkey,
    public.logistics_logisticsmanifest,
    public.logistics_logisticscurrentstate,
    public.logistics_logisticseditioncontrol,
    public.logistics_offlinescanbatch
    FROM PUBLIC;
GRANT SELECT, INSERT, UPDATE ON TABLE
    public.logistics_restrictedlogisticsaddress,
    public.logistics_equipmentoffer,
    public.logistics_physicalkey,
    public.logistics_logisticsmanifest,
    public.logistics_logisticscurrentstate,
    public.logistics_logisticseditioncontrol,
    public.logistics_offlinescanbatch
    TO maru_runtime;

-- setval() is authorized by UPDATE and changes a sequence outside ordinary
-- MVCC rollback.  Runtime needs USAGE/SELECT only.
REVOKE UPDATE ON ALL SEQUENCES IN SCHEMA public FROM maru_runtime;

-- session_replication_role=replica disables ordinary integrity triggers.
-- Neither PUBLIC nor the runtime login may acquire an explicit parameter ACL.
REVOKE SET, ALTER SYSTEM ON PARAMETER session_replication_role FROM PUBLIC;
REVOKE SET, ALTER SYSTEM ON PARAMETER session_replication_role
    FROM maru_runtime;

-- Functions are executable by PUBLIC by default.  The ADR 0046 v2 allowlist below is
-- the complete non-trigger helper closure used by Maru's current runtime SQL
-- and database triggers.  A change must update code, migration evidence, this
-- file, and the genuine-login service smoke together.
REVOKE EXECUTE ON ALL FUNCTIONS IN SCHEMA public FROM PUBLIC;
REVOKE EXECUTE ON ALL FUNCTIONS IN SCHEMA public FROM maru_runtime;
ALTER DEFAULT PRIVILEGES FOR ROLE maru_migration IN SCHEMA public
    REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
GRANT EXECUTE ON FUNCTION
    public.maru_assert_active_board_membership_provenance(uuid),
    public.maru_assert_active_executive_board(uuid),
    public.maru_assert_active_executive_board_v0009(uuid),
    public.maru_assert_authority_issuance_complete(bigint),
    public.maru_assert_authority_issuance_complete_internal(
        bigint,
        bigint[],
        integer
    ),
    public.maru_assert_authority_provenance_activation(),
    public.maru_assert_authority_target_complete(character varying, uuid),
    public.maru_audit_test_reset_allowed(),
    public.maru_authority_bundle_historical_v1(
        uuid,
        timestamp with time zone,
        uuid,
        bigint[],
        integer
    ),
    public.maru_authority_issuance_valid_v1(
        bigint,
        uuid,
        character varying,
        uuid,
        uuid,
        uuid,
        uuid,
        timestamp with time zone,
        timestamp with time zone,
        timestamp with time zone,
        boolean,
        boolean,
        bigint[],
        integer
    ),
    public.maru_authority_provenance_is_active(),
    public.maru_lock_authority_provenance_latch(),
    public.maru_authority_provenance_test_reset_allowed(),
    public.maru_authority_scope_contains_v1(
        uuid,
        uuid,
        uuid,
        uuid,
        uuid,
        uuid,
        uuid,
        uuid
    ),
    public.maru_authority_scope_is_current_v1(uuid, uuid, uuid, uuid),
    public.maru_authorization_capability_min_scope(text),
    public.maru_authorization_scope_contains(
        uuid,
        uuid,
        uuid,
        uuid,
        uuid,
        uuid,
        uuid,
        uuid
    ),
    public.maru_authorization_scope_rank(uuid, uuid, uuid),
    public.maru_workforce_role_evidence_matches_position(
        uuid,
        uuid,
        uuid,
        uuid,
        uuid,
        uuid
    )
    TO maru_runtime;

-- These are denied explicitly for review clarity.  The ordinary DML grants
-- above do not include them.
REVOKE TRIGGER, TRUNCATE, MAINTAIN
    ON ALL TABLES IN SCHEMA public
    FROM maru_runtime;

-- Repeat the schema grants/revokes for every intentional non-system schema.
-- The runtime role must not own the database, a user schema, a relation, or a
-- function, and must not inherit any owner, predefined pg_* role, or privileged
-- role.  MARU_RUNTIME_DATABASE_ROLE=maru_runtime makes Maru prove this catalog
-- boundary before exact-provenance activation and on public runtime readiness.
-- Activation itself runs only through the controlled migration/cutover owner.
-- Readiness also rejects effective parameter ACLs, non-origin role/database
-- settings, sequence UPDATE, reachable membership ADMIN OPTION, object grant
-- options, any runtime DML on migration metadata or the two cutover-state
-- relations, REFERENCES on the SELECT-only control trio, DELETE/REFERENCES on
-- the structure control, or UPDATE/DELETE/REFERENCES on structure receipts.
-- Registration setup and account onboarding additionally requires UPDATE-only account-inventory control access,
-- append-only invitation, delivery-attempt, late-outcome, and reconciliation
-- evidence plus retention receipts, SELECT-only retention-policy control,
-- one-way hold updates, and no DELETE/REFERENCES on its mutable challenge,
-- invitation, or delivery aggregates. These ACLs are not evidence that Registration setup and account onboarding's separate
-- stopped-writer cutover has occurred.

COMMIT;

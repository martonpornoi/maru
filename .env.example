# Development only. Never copy production secrets into this file.
MARU_SETTINGS_MODULE=maru.settings.local
MARU_SECRET_KEY=development-only-change-me
MARU_DATABASE_URL=postgresql://maru:maru@127.0.0.1:5432/maru
# Role name only, never a password. Production uses a separate non-owner role.
MARU_RUNTIME_DATABASE_ROLE=
MARU_ALLOWED_HOSTS=localhost,127.0.0.1
MARU_BUILD_VERSION=development
MARU_BUILD_COMMIT=unknown
MARU_PUBLIC_BASE_URL=http://127.0.0.1:8000
MARU_DEFAULT_FROM_EMAIL=no-reply@maru.invalid
# Page 10 invitations fail closed until these public encryption and dedicated
# versioned digest-key settings are configured. Never reuse MARU_SECRET_KEY.
# The matching encryption private-key ring belongs only to the delivery worker.
MARU_IDENTITY_INVITATION_ENCRYPTION_KEY_ID=
MARU_IDENTITY_INVITATION_PUBLIC_KEY_B64=
MARU_IDENTITY_INVITATION_DIGEST_ACTIVE_KEY_ID=
MARU_IDENTITY_INVITATION_DIGEST_KEYS_JSON=
# Closed JSON object; there is deliberately no retention-duration default.
# Required keys: policy_id, version, jurisdiction_code, trigger, period_days,
# action, approved_by_reference, approved_at. See the deployment runbook.
MARU_IDENTITY_INVITATION_RETENTION_POLICY_JSON=
# Production only: exact provider API and hosted-checkout hosts, comma separated.
MARU_PAYMENT_PROVIDER_HOSTS=payments.example,checkout.example
# Exact origins to which hosted checkout may return.
MARU_PAYMENT_RETURN_ORIGINS=http://127.0.0.1:5173
# Exact annual registration-site origins allowed to use cookie-authenticated APIs.
MARU_REGISTRATION_CLIENT_ORIGINS=http://127.0.0.1:5173
# The same HTTPS frontend origins must be trusted for CSRF in production.
MARU_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5173
# Production SMTP delivery (use a secret manager for the password).
MARU_EMAIL_HOST=smtp.example
MARU_EMAIL_PORT=587
MARU_EMAIL_HOST_USER=development
MARU_EMAIL_HOST_PASSWORD=development-only
MARU_EMAIL_USE_TLS=true
MARU_EMAIL_USE_SSL=false
# Production image scanning and bounded offline credential manifests.
MARU_MEDIA_SCANNER=disabled
MARU_MEDIA_SCANNER_HOST=
MARU_MEDIA_SCANNER_PORT=3310
MARU_MEDIA_SCANNER_TIMEOUT_SECONDS=5
MARU_OFFLINE_MANIFEST_SECRET=development-only-change-me
# These fail-closed production defaults must not be relaxed for convenience.
MARU_ALLOW_PROVISIONAL_PUBLIC_REGISTRATION=false
MARU_IDENTITY_EXPOSE_TEST_TOKENS=false
MARU_EXPOSE_TEST_CREDENTIAL_TOKENS=false
MARU_REQUIRE_PRIVILEGED_STEP_UP=true
MARU_ENFORCE_EDITION_CLOSURE_GATES=true
MARU_REQUIRE_EXACT_AUTHORITY_PROVENANCE=false
